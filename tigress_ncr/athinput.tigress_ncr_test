<comment>
problem   = TIGRESS-NCR lightweight test (ray tracing + NCR photochemistry, MHD)
reference = Kim, JG et al. 2023; Kim, CG et al. 2023
configure = --prob=tigress_ncr -fft --grav=fft -mpi -hdf5 --nghost=4 -b --flux=hlld -ncr
# 16 pc resolution, 1024 x 1024 x 4096 pc box -> 64 x 64 x 256 cells.
# meshblock 32^3 -> 2 x 2 x 8 = 32 blocks -> run on 32 ranks (1 block/rank).
# (meshblock 16^3 -> 4 x 4 x 16 = 256 blocks -> 256 ranks.)

<job>
problem_id = TIGRESS_NCR_TEST # problem ID: basename of output filenames
output_timing = true

<output1>
file_type = hst   # History data dump
dt        = 0.01  # time increment between outputs
dcycle    = 0

<output2>
file_type   = hdf5      # Binary data dump
variable    = prim      # variables to be output
dt          = 1         # time increment between outputs
dcycle      = 0
ghost_zones = false

<output3>
file_type   = parbin  # Binary data dump
dt          = 1       # time increment between outputs
dcycle      = 0

<output4>
file_type = rst # Restart data dump
dt        = 50  # time increment between outputs
dcycle    = 0

<output5>
file_type = phase_hst   # History data dump
dt        = 0.01  # time increment between outputs
dcycle    = 0

<output6>
file_type = zprof      # zprof data dump
dt        = 1          # time increment between outputs
dcycle    = 0

<output7>
file_type   = hdf5      # Binary data dump
variable    = uov       # variables to be output
dt          = 10        # time increment between outputs
dcycle      = 0
ghost_zones = false


<time>
cfl_number       = 0.3    # The Courant, Friedrichs, & Lewy (CFL) Number
nlim             = -1     # cycle limit
tlim             = 100.0  # time limit
integrator       = rk2    # time integration algorithm
xorder           = 2      # order of spatial reconstruction
ncycle_out       = 10     # interval for stdout summary info
dt_diagnostics   = -1
ncycle_out_timing = 100
ops_task         = true   # required: NCR photochemistry runs in the ops task list
cr_integrator    = rk1

<mesh>
nx1         = 64             # Number of zones in X1-direction (16 pc)
x1min       = -512           # minimum value of X1
x1max       = 512            # maximum value of X1
ix1_bc      = shear_periodic # inner-X1 boundary flag
ox1_bc      = shear_periodic # outer-X1 boundary flag
nx2         = 64             # Number of zones in X2-direction (16 pc)
x2min       = -512           # minimum value of X2
x2max       = 512            # maximum value of X2
ix2_bc      = periodic       # inner-X2 boundary flag
ox2_bc      = periodic       # outer-X2 boundary flag
nx3         = 256            # Number of zones in X3-direction (16 pc)
x3min       = -2048          # minimum value of X3
x3max       = 2048           # maximum value of X3
ix3_bc      = user           # inner-X3 boundary flag
ox3_bc      = user           # outer-X3 boundary flag
refinement  = none
mhd_outflow_bc = diode
cr_outflow_bc = lngrad_out

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<hydro>
gamma           = 1.666666666667 # gamma = C_p/C_v
iso_sound_speed = 1.00           # equavalent to sqrt(gamma*p/d) for p=0.1, d=1
neighbor_flooring = true
fofc              = true
fofc_shear        = false
fofc_full         = false
prolonged_fofc    = true
dfloor            = 1.e-8
pfloor            = 1.e-8
tsqfloor          = 1.e-2
ct_method         = uct_hlld

<gravity>
grav_bc   = disk
output_gasonly_potential = true
solve_grav_hyperbolic_dt = false

<orbital_advection>
OAorder    = 0       # 0: w/o OA, 1: w/ OA (1st), 2: w/ OA (2nd)
qshear     = 1       # shear rate
Omega0     = 0.028   # angular velocity of the system
shboxcoord = 1       # 1=xy (default); 2=xz

<ray_tracing>
ray_tracing   = true    # true or false
rays_per_cell = 4.0     # Nominal angular resolution (can be a real number)
healpix_lev_min = 4     # HealPix level at creation
nexit_max     = 100     # Maximum number of rays to send to neighbor ranks (MPI only)
tau_max       = 30.0    # Stop following a ray if tau > tau_max at all freq bins
rotate_rays   = true    # Apply random rotation to ray directions

<photchem>
photchem = true
mode = ncr
bookkeeping = true          # Keep track of heating/cooling rates (uov)
flag_op_split  = true       # Operator split update (required)
flag_rad_force = false      # Turn on radiation pressure force
flag_update_dt_main = false # Update dt_main using dt_user=dt_coolchem
cfl_photchem = 1.0          # dt_user = cfl_photchem*t_coolchem
ceiling = true              # density floor to ceiling velocity and temperature

<photchem_ncr>
cool_hyd_cie_flag = false
cool_dust_flag = false
h2_diss_bg_flag = true
nsub_max = 50
cfl_cool_sub = 0.1
temp_hot0 = 20000.0
temp_hot1 = 35000.0
sigma_dust_pe0 = 1e-21
sigma_dust_lw0 = 2e-21

x_hi_cut = 1.e-2
x_hii_cut = 1.e-2
x_h2_cut = 1.e-2

z_gas = 1.0
z_dust = 1.0

chi0 = 1.0
xi_cr0 = 2e-16          # unattenuated CR ionization rate [1/s]
shld_n_hyd0 = 1e2
shld_len0 = 0.0         # zero to turn off
shld_pow_idx = -0.7
shld_column_hyd_cr0 = 9.35e20

# Cross sections and photon energies in (LyC,LW,PE) bands
hnu[0]      = 18.0
sigma_d[0]     = 1.0e-21 # smaller than theoretical estimate
sigma_pi_HI[0] = 3.1e-18
sigma_pi_H2[0] = 4.6e-18
hnu[1]      = 12.2
sigma_d[1]     = 2.0e-21
sigma_pi_HI[1] = 0.0
sigma_pi_H2[1] = 0.0
hnu[2]      = 9.0
sigma_d[2]     = 1e-21
sigma_pi_HI[2] = 0.0
sigma_pi_H2[2] = 0.0

coolftn_file   = tigress_coolftn_ncr.txt  # file name for high-T cooling table

<particle1>
type    = complex
gravity = true
output  = true
output_pm = false
feedback  = true        # turn on feedback from particles
feedback_rad = true     # star particles act as ray-tracing radiation sources
accretion = 1
mass_return = true
lp_coefficient = 2.0
csmin = 0.1
fgas    = 0.0
r_return = -1           # negative for no return; 0 to entire volume
t_return = 2.5
dt_return = 1
t_duration = 10
return_to_warm = true
type_ia_sn = false
A_Ia = 4.4e-2
B_Ia = 0.0

<particle2>
type      = none
gravity   = false
output    = false
output_pm = false
feedback  = true     # turn on feedback from particles
rseed     = 10

<feedback>
ischeme       = Classic     # injection scheme
pop_synth     = SB99     # population synthesis scheme
M_inj         = 1000                # Total injected mass (gas+star) in Msun
E_inj         = 1.0                # Energy injected in units of 10^51 ergs
M_ej          = 10                 # Ejecta mass (star) in Msun
fe_CR         = 0.1               # energy fraction in CR
tdec_scr      = 0.04              # decay time of CR scalar in Myr
tdec_rt       = 10
iSN           = 1        # turn on supernovae
iFUV          = 1
pop_synth_file = Z014_GenevaV00.txt
rfb_res       = 3.0      # feedback radius in grid cells
fkin          = 0.28     # kinetic energy fraction
mratio_thresh = 0.1      # mass ratio threshold for energy inejction mode
iredist       = false    # redistribute if momentum feedback?
write_rprof   = false
vmax          = 5000     # maximum velocity by the feedback injection
fbinary       = 0.0

<cr>
# Only used for the CRMHD milestone (configure with --cr=mg); ignored for MHD builds.
vmax                 = 2e9
fofc                 = true
neighbor_flooring    = true
vflx                 = false
taucell              = 1
vs_flag              = 1
src_flag             = 1
losses_flag          = 1
perp_diff_flag       = 1
self_consistent_flag = 1
valfven_flag         = 1
obs_spectrum_flag    = 1
postprocess_flag     = 0
coll_ion_flag        = 1
ecfloor              = 1e-18
sigma                = 1e-25
max_opacity          = 10000000000
perp_to_par_diff     = 10
obs_spectrum_slope   = -4.7
cr_ops_task          = false

<problem>
Sigma_gas  = 12
sz1        = 10
Sigma_star = 42
z_star     = 245
rho_dm     = 0.0064
R0         = 8
beta0      = 10.0
beta_r     = 0.0

turb_flag  = 1
v1d        = 10
dedt       = 1.0          # a place holder (will be updated based on v1d)

ext_grav   = force

<perturbation>
nlow       = 1     # cut-off wavenumber at low-k
nhigh      = 8     # cut-off wavenumber at high-k
expo       = 2.0   # power-law exponent
f_shear    = 0.5   # the ratio of the shear component
rseed      = -1    # if non-negative, seed will be set by hand (slow PS generation)
