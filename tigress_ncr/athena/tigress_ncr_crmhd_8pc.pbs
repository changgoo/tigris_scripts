#!/bin/bash
#PBS -N crncr-8pc
#PBS -q normal
#PBS -W group_list=s2800
#PBS -l select=2:ncpus=256:mpiprocs=192:model=tur_ath
#PBS -l place=scatter:excl
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -m abe
#PBS -M changgoo@princeton.edu
#
# 8 pc CRMHD + NCR *coupling* run of the TIGRESS-NCR executable on NASA Athena Turin
# nodes (2x AMD EPYC 9745, 256 cores/node), built with --physics=crmhd
# (-b --cr=mg --flux=hlld -ncr).
#
# The coupling (both directions) is turned on at runtime by cr/photchem_flag=1:
#   - CR energy density  -> per-cell NCR cosmic-ray ionization rate (xi_cr)
#   - NCR ion/neutral abundances -> CR scattering coefficient (CROpacity)
# It requires <cr>/self_consistent_flag=1 and <photchem>/mode=ncr (both set in
# athinput.tigress_ncr).
#
# Runs the production input (athinput.tigress_ncr) with the mesh overridden to 8 pc:
#   128x128x768 over the full 1024x1024x6144 pc box, 32^3 blocks
#   -> 4*4*24 = 384 blocks -> 384 ranks (1 block/rank) on 2 nodes, 192 ranks per node
#   spread evenly over the 16 CCDs of each node (env.sh cpu_bind).
#
# Toolchain: built by build_tigress.sh --machine=athena --cc=<toolchain>; the matching
# modules come from env.sh. gcc (GCC 14 + cray-mpich 8.1.33) is the default: fastest in
# the Athena benchmark (README.md).
#
# Gravity: SPARSE_GRAV=1 solves self-gravity once per dt_hyperbolic instead of every
# cycle (gravity/solve_grav_hyperbolic_dt=true). The CR-limited dt is much shorter than
# the MHD one. Before the FI_MR_CACHE_MONITOR=memhooks fix in env.sh this cut the CRMHD
# cycle time by 22-36% on Athena; with it the gravity solve is cheap and the gain is 6%
# (restart, 0.278 -> 0.260 s/cycle). It is off by default, as in the runs so far.
#
# Long production run: chains itself via restart when it stops on the walltime soft
# limit (athena exit code 3).
#
# Usage (PBS passes options through -v, not positional arguments):
#   qsub [-v STARTFLAG=-r,TAG=...,CC=gcc,RUNBASE=...,SPARSE_GRAV=1] tigress_ncr_crmhd_8pc.pbs
#     STARTFLAG=-r : restart from $PID.final.rst in the run directory, or, if there is
#                    none, from the newest $PID.NNNNN.rst there
#     TAG          : suffix of the run-directory name
#     CC           : toolchain [default: gcc]
#     RUNBASE      : parent of the run directory [default: /nobackup/$USER/tigress_ncr]
#     SPARSE_GRAV  : 1 = gravity once per dt_hyperbolic [default: 0]
#     NO_CHAIN     : 1 = do not resubmit on the walltime limit (short test jobs)

CC=${CC:-gcc}
STARTFLAG=${STARTFLAG:-}
TAG=${TAG:-}
SPARSE_GRAV=${SPARSE_GRAV:-0}

# Problem definition and paths
physics=crmhd
grav=fft
prob=tigress_ncr
PID=TIGRESS_NCR
SRCDIR=$HOME/tigris/.worktrees/production-diagnostics  # worktree the exe was built from
SCRIPTDIR=$HOME/tigris_scripts/$prob         # holds athinput.$prob
PBSDIR=$SCRIPTDIR/athena                     # holds the exe, env.sh and this script
SCRIPT=${prob}_${physics}_8pc.pbs

type module > /dev/null 2>&1 || source /opt/cray/pe/modules/3.2.11.7/init/bash
source "$PBSDIR/env.sh"
load_toolchain "$CC" || exit 1
export OMP_NUM_THREADS=1 FI_PROVIDER=cxi

# Executable (under $PBSDIR) and input file
EXE=tigris_ncr_${physics}-${grav}-${CC}.exe  # e.g. tigris_ncr_crmhd-fft-gcc.exe
EXEPATH=${PBSDIR}/$EXE
INPUT=${SCRIPTDIR}/athinput.${prob}

# --- 8 pc override: refine the 16 pc input to 8 pc over the SAME box -----------
HIRES="mesh/nx1=128 mesh/nx2=128 mesh/nx3=768"
NPROCS=384
NODES=$(sort -u "$PBS_NODEFILE" | wc -l)
PPN=$((NPROCS / NODES))
# ------------------------------------------------------------------------------

# Data tables
TBLDIR="$SRCDIR/inputs/tables"
COOL_TBL="tigress_coolftn_ncr.txt"
POPSYNTH_TBL="Z014_GenevaV00.txt"

# Informative run-directory name: <physics>-ncr-<res>pc (res from box / override nx1)
mesh_val () {
    grep -E "^[[:space:]]*$1[[:space:]]*=" "$INPUT" | head -1 | sed -E 's/#.*//; s/[^=]*=[[:space:]]*//; s/[[:space:]]*$//'
}
x1min=$(mesh_val x1min); x1max=$(mesh_val x1max)
nx1=$(echo "$HIRES" | grep -oE 'nx1=[0-9]+' | head -1 | cut -d= -f2)
res=$(( (x1max - x1min) / nx1 ))
RUNNAME=${physics}-ncr-${res}pc${TAG}
RUNBASE=${RUNBASE:-/nobackup/$USER/tigress_ncr}
RUNDIR=$RUNBASE/$RUNNAME

# Runtime parameter overrides (data-table filenames must be relative to RUNDIR).
# cr/photchem_flag=1 turns on the CR<->NCR coupling.
params="job/problem_id=$PID job/output_timing=true $HIRES cr/photchem_flag=1 \
        ray_tracing/rayt_sparse=true ray_tracing/dist_xy_max=2048 ray_tracing/eps_extinct=1.e-8 \
        photchem_ncr/coolftn_file=$COOL_TBL feedback/pop_synth_file=$POPSYNTH_TBL"
[ "$SPARSE_GRAV" == "1" ] && params="$params gravity/solve_grav_hyperbolic_dt=true"

LAUNCH="$MPI_LAUNCH -n $NPROCS --ppn $PPN --cpu-bind $(cpu_bind "$PPN")"

echo "RUNDIR = $RUNDIR"
echo "EXE    = $EXEPATH"
echo "INPUT  = $INPUT"
echo "LAUNCH = $LAUNCH"

if [ ! -x "$EXEPATH" ]; then
    echo "ERROR: executable not found: $EXEPATH"
    echo "       build it with: build_tigress.sh --machine=athena --cc=$CC --physics=$physics --worktree=production-diagnostics"
    exit 1
fi

# Create/clean the run directory. A fresh start never deletes restart files.
if [ -d "$RUNDIR" ] ; then
    echo "directory exists"
    if [[ $STARTFLAG != "-r" ]]; then
        if compgen -G "$RUNDIR/*.rst" > /dev/null; then
            echo "ERROR: $RUNDIR holds restart files; use -v STARTFLAG=-r, or move them away for a fresh start"
            exit 1
        fi
        echo "cleaning up"
        rm -rf "$RUNDIR"/*
    fi
else
    mkdir -p "$RUNDIR"
fi

cd "$RUNDIR"
echo "params = $params"
set -o pipefail

# Stage the executable and tables on every segment so a toolchain change takes effect.
cp "${PBSDIR}/$SCRIPT" .
cp "$EXEPATH" .
cp "$TBLDIR/$COOL_TBL" .
cp "$TBLDIR/$POPSYNTH_TBL" .

RSTINPUT=$PID.final.rst
if [[ $STARTFLAG == "-r" && ! -f "$RSTINPUT" ]]; then
    RSTINPUT=$(ls -1 $PID.[0-9]*.rst 2>/dev/null | sort | tail -1)
fi

# Athena's -t soft limit: the PBS walltime minus 30 minutes (a fifth of it for short
# test jobs) for the final dump.
WALL=$(qstat -f "$PBS_JOBID" 2>/dev/null | sed -n 's/.*Resource_List.walltime = //p')
WSEC=$(echo "${WALL:-08:00:00}" | awk -F: '{print $1*3600 + $2*60 + $3}')
MARGIN=$(( WSEC / 5 < 1800 ? WSEC / 5 : 1800 ))
TSEC=$(( WSEC - MARGIN ))
TLIM=$(printf '%02d:%02d:%02d' $((TSEC / 3600)) $((TSEC % 3600 / 60)) $((TSEC % 60)))

if [[ $STARTFLAG != "-r" ]]; then
    echo "Starting fresh"
    cp "$INPUT" .
    $LAUNCH "./$EXE" -i "$(basename "$INPUT")" -t "$TLIM" $params \
        1> "$RUNDIR/out.txt" 2> "$RUNDIR/err.txt"
elif [ -n "$RSTINPUT" ] && [ -f "$RSTINPUT" ]; then
    echo "Restarting from $RSTINPUT"
    rstnum=$(ls out*.txt 2>/dev/null | wc -l)
    # Parameters absent from the restart file (e.g. a new <hydro> switch) cannot be
    # set on the command line; put them in $RESTART_ADD in the run directory.
    RESTART_ADD=athinput.restart_add
    ADDARG=""
    if [ -f "$RESTART_ADD" ]; then
        ADDARG="-i $RESTART_ADD"
        echo "Restart add-on input: $RESTART_ADD"
    fi
    RSTPAR=""
    [ "$SPARSE_GRAV" == "1" ] && RSTPAR="gravity/solve_grav_hyperbolic_dt=true"
    $LAUNCH "./$EXE" -r "$RSTINPUT" $ADDARG -t "$TLIM" $RSTPAR \
        1> "$RUNDIR/out.r${rstnum}.txt" 2> "$RUNDIR/err.r${rstnum}.txt"
else
    echo "ERROR: STARTFLAG=-r given but no restart file in $RUNDIR"
    exit 1
fi

EXITCODE=$?
echo "EXITCODE = $EXITCODE"
set +o pipefail

# Athena exits with code 3 when it stops on the walltime soft limit (-t): resubmit.
if [[ $EXITCODE -eq 3 && "${NO_CHAIN:-0}" != "1" ]]; then
    echo "Resubmitting"
    cd "$PBSDIR"
    qsub -v "STARTFLAG=-r,TAG=$TAG,CC=$CC,RUNBASE=$RUNBASE,SPARSE_GRAV=$SPARSE_GRAV" "$SCRIPT"
fi
