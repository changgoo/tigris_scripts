#PBS -q devel
#PBS -l select=1:ncpus=32:mpiprocs=32:model=tur_ath
#PBS -l walltime=002:00:00
#PBS -m abe
#PBS -M changgookim@gmail.com

module purge
module load PrgEnv-cray cray-pals cray-libpals craype-x86-turin perftools-base cray-hdf5-parallel cray-fftw
module switch PrgEnv-cray PrgEnv-gnu
# libfabric's default MR cache monitor (userfaultfd) caps each NIC at ~230K
# medium messages/s; memhooks makes FFT gravity ~4x faster (tigress_ncr/athena/README.md)
export FI_MR_CACHE_MONITOR=memhooks

# make quick snapshots
cd $RUNDIR

PYTHONDIR=$HOME/pyathena_tigris
export PYTHONPATH="$PYTHONDIR:$PYTHONPATH"
pythonscript=$HOME/TIGRESS-CR/python/plot_slices.py

/home1/ckim14/myenv/bin/mpiexec -np 32 python -m mpi4py $pythonscript `pwd`
